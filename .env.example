# Copy to .env.local and fill in. Never commit real values.

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                 # filled in after the webhook is registered
PAYPAL_SANDBOX_BUSINESS_EMAIL=     # Maya's US sandbox Business account
PAYPAL_SANDBOX_BUYER_EMAIL=        # US sandbox Personal account (client / buyer)

# --- AI (OpenAI) ---
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini
AI_FALLBACK_MODEL=                 # optional, e.g. a stronger GPT model

# --- Database: Neon (pooled connection strings) ---
DATABASE_URL=                      # dev branch, for local work
DATABASE_URL_PROD=                 # main branch (Render uses it as DATABASE_URL)

# --- Render Workflows (on Render only; locally the agent runs in-process) ---
USE_RENDER_WORKFLOWS=              # "true" on Render
RENDER_API_KEY=
WORKFLOW_SLUG=cleared-wf

# --- Files, sessions, demo ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
SESSION_SECRET=
DEMO_MODE=true
DEMO_TEST_DISPUTES=                # "true" locally and in e2e: the demo dispute is a labelled test dispute, not the real sandbox stock
