{
  "name": "cleared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/db.ts --seed",
    "test": "vitest run",
    "workflow:dev": "render workflows dev -- npm run workflow:start",
    "workflow:start": "tsx --conditions=react-server src/workflows/main.ts",
    "disputes:sync": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/sync-disputes.ts",
    "db:cleanup": "tsx --env-file-if-exists=.env.local scripts/db.ts --cleanup",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval-agent.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@base-ui/react": "^1.9.0",
    "@number-flow/react": "^0.6.2",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@renderinc/sdk": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "openai": "^7.39.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
